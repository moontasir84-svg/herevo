# Copy to .env for local development. In production set these in the host's environment settings.
# NEVER commit a real .env file or paste keys in chat.

# test = made-up messages only (free providers allowed) · live = real women (paid, private providers only)
DATA_MODE=test

DATABASE_URL=postgresql://herevo:herevo@localhost:5432/herevo

# Which model answers: gemini (free tier, TEST ONLY) or claude
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Claude (console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Embeddings: "hash" works offline with no key; "voyage" for real multilingual semantic search
EMBEDDINGS_PROVIDER=hash
VOYAGE_API_KEY=

# Telegram (@BotFather) and the helpers' chat that receives safety alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=pick-a-long-random-string
HELPER_CHAT_ID=

# Voice notes: gemini (free, TEST ONLY, transcription only) or google (Cloud Speech, needs billing)
SPEECH_PROVIDER=gemini
GOOGLE_API_KEY=
VOICE_REPLIES=true

# Random string used to hash user ids (keep it secret, never change it after launch)
ID_SALT=pick-another-long-random-string

DEFAULT_COUNTRY=BD
